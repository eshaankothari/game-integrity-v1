# Copy to .env and fill in.  .env is gitignored; this file is not.
#   cp .env.example .env
#
# The dashboard needs NONE of the API keys -- it reads the database only.
# Keys are required solely to RE-RUN the ingest pipeline (L1-L3), which is
# already done and captured in the database file.

# --- database -------------------------------------------------------------
# DuckDB: a path to the single-file database that ships with this repo.
GI_DB=game_integrity.duckdb

# --- paid API caches (optional) -------------------------------------------
# Responses already paid for. Point this at the cache directory if you have
# it; without it the loaders would re-fetch and re-bill for data we own.
# Not needed to run the dashboard.
GI_CACHE=./cache

# --- API keys (optional: ingest only) -------------------------------------
# https://the-odds-api.com  -- historical player props. 10 credits per call.
ODDSAPI_KEY=

# L9 reviewer. Only one is needed, matching LLM_MODEL below.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Provider is inferred from the name: 'gemini-*' -> Gemini, else Anthropic.
LLM_MODEL=gemini-3.5-flash-lite
