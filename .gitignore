# --- API response caches (large, regenerable, and paid-for locally) ---
# cache/snapshots holds ~1,000 OddsAPI responses (~33MB). They are reproducible
# from the API and contain vendor data, so they stay local.
cache/

# --- secrets ---
.env
*.key

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- editor / OS ---
.DS_Store
.idea/
.vscode/
.claude/

# analysis exports (regenerable)
out/

# frontend
frontend/node_modules/
frontend/dist/

# editor backups
*.bak

# --- exploratory work, kept locally but not shipped ---
# 27 scripts and 105MB of plots behind decisions that are already recorded in
# METHODOLOGY.md ("Tested and rejected"). They stay on the author's machine;
# a reader needs the verdicts, not the dead ends.
experiments/

# never commit real credentials -- .env.example documents the shape instead
.env.*
!.env.example

# vite dependency pre-bundle cache (regenerated on every dev start)
frontend/.vite/

# game_integrity.duckdb is deliberately COMMITTED, not ignored. It is a build
# artifact, but it is also the whole point of the handoff: 21MB means a recipient
# clones and runs, with no database server to install or dump to restore.
# Regenerate from Postgres with `make duckdb`.

# --- CSV export (make csv) ---
# NOT committed, unlike game_integrity.duckdb. It is 102 MB -- three times the .duckdb
# file it is generated from -- and every byte of it is reproducible in under two seconds
# by `make csv`, which falls back to the committed .duckdb when there is no Postgres.
# Committing it would triple the clone size to ship a redundant copy of the same rows.